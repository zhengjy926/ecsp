# 换行符统一：仓库内存 LF，检出到工作区也用 LF
* text=auto eol=lf

# Windows 批处理必须 CRLF，否则可能无法执行
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制文件不做换行符转换（也避免 diff 被当文本处理）
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.7z binary
*.bin binary
*.hex binary
*.elf binary
*.a binary
*.o binary
