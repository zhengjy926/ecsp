  "cards": [
    {
      "dot": "cyan",
      "title": "分层裁剪",
      "items": [
        "从机固件只开 L1-L3；主机侧开 L1、L2、L4",
        "L3 与 L4 互不引用，同进程可并存多实例"
      ]
    },
    {
      "dot": "emerald",
      "title": "硬约束",
      "items": [
        "C99、零动态分配、无可变全局、库内不取时钟",
        "非阻塞事件驱动；调用方推入 now_ms 与收发缓冲"
      ]
    },
    {
      "dot": "amber",
      "title": "板卡边界",
      "items": [
        "0x30-0xEF 语义留在 board/，以编译期命令表注入",
        "身份 NVM 与 USART 属于产品，不进协议库"
      ]
    }
  ]
